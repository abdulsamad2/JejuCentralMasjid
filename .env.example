# Copy to .env.local for local development.

# Required: session/JWT encryption secret (any long random string)
PAYLOAD_SECRET=generate-a-long-random-string

# Required: Neon Postgres connection string.
# In production Vercel injects this automatically once the Neon integration
# is installed. For local dev, run `vercel env pull .env.local` or paste the
# connection string from the Vercel dashboard (Storage -> your Neon database).
POSTGRES_URL=

# Search engine ownership verification (optional — set after registering at
# Google Search Console and Naver Search Advisor)
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# NEXT_PUBLIC_NAVER_SITE_VERIFICATION=

# Umami open-source analytics (optional). Create a site at https://cloud.umami.is
# (free tier) or your own self-hosted Umami, then set:
# NEXT_PUBLIC_UMAMI_WEBSITE_ID=
# NEXT_PUBLIC_UMAMI_SRC=https://cloud.umami.is/script.js
# NEXT_PUBLIC_UMAMI_SHARE_URL=   # dashboard "share" link, shown in /admin
